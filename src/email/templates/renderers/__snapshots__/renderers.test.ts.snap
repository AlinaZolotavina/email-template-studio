padding:12px 40px 24px 40px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td align="center" valign="top" style="padding:0px 10px;width:120px"><p style="color:#C2410C;font-family:Arial;font-size:12px;font-weight:700;line-height:18px;margin:0px 0px 5px 0px;text-align:center">OK</p><p style="color:#111827;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px;text-align:center">QUALITY YOU CAN TRUST</p></td><td align="center" valign="top" style="padding:0px 10px;width:120px"><p style="color:#C2410C;font-family:Arial;font-size:12px;font-weight:700;line-height:18px;margin:0px 0px 5px 0px;text-align:center">FAST</p><p style="color:#111827;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px;text-align:center">FAST &amp; RELIABLE SHIPPING</p></td><td align="center" valign="top" style="padding:0px 10px;width:120px"><p style="color:#C2410C;font-family:Arial;font-size:12px;font-weight:700;line-height:18px;margin:0px 0px 5px 0px;text-align:center">EASY</p><p style="color:#111827;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px;text-align:center">EASY RETURNS, NO HASSLE</p></td></tr></tbody></table></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:8px 40px 32px 40px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center"><tbody><tr><td align="center" bgcolor="#C2410C" style="border-radius:6px;background-color:#C2410C"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="https://example.com/offer" style="height:48px;v-text-anchor:middle;width:176px" arcsize="10%" stroke="f" fillcolor="#C2410C"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial;font-size:16px;font-weight:bold"><![endif]--><a href="https://example.com/offer" target="_blank" style="background-color:#C2410C;border-radius:6px;color:#FFFFFF;display:inline-block;font-family:Arial;font-size:16px;font-weight:bold;line-height:48px;padding:0 24px;text-align:center;text-decoration:none;mso-hide:all">SHOP NOW</a><!--[if mso]></center></v:roundrect><![endif]--></td></tr></tbody></table></td></tr><tr><td align="center" style="border-color:#D9DED9;border-style:solid;border-width:1px;padding:0px 48px 20px 48px"><p style="color:#6B7280;font-family:Arial;font-size:10px;line-height:15px;margin:0px;text-align:center">Offer valid through May 25, 2026 at 11:59 PM PT. Exclusions apply. Discount shown at checkout.</p></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="mailto:hello@example.com" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Email</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/instagram" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">IG</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/facebook" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">f</a></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:10px 32px 0px 32px"><p style="color:#6B7280;font-family:Arial;font-size:10px;line-height:16px;margin:0px;text-align:center">You're receiving this email because you signed up for updates.</p></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/unsubscribe" target="_blank" style="color:#6B7280;font-family:Arial;font-size:10px;font-weight:600;text-decoration:underline">Unsubscribe</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/preferences" target="_blank" style="color:#6B7280;font-family:Arial;font-size:10px;font-weight:600;text-decoration:underline">Manage preferences</a></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:8px 32px 24px 32px"><p style="color:#6B7280;font-family:Arial;font-size:9px;line-height:14px;margin:0px;text-align:center">1234 Market St, Suite 567, San Francisco, CA 94103</p></td></tr></tbody></table></div></td></tr></tbody></table></center></body></html>"`;

exports[`'welcome-onboarding' renderer > renders the default full email document and matches its snapshot 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no"><title>Welcome aboard!</title><!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]--><style>html,body{margin:0!important;padding:0!important;width:100%!important;height:100%!important}*{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}table,td{mso-table-lspace:0pt!important;mso-table-rspace:0pt!important;border-collapse:collapse!important}img{-ms-interpolation-mode:bicubic;border:0;height:auto;line-height:100%;outline:none;text-decoration:none}a{text-decoration:none}@media screen and (max-width:620px){.email-container{width:100%!important;max-width:100%!important}.mobile-padding{padding-left:20px!important;padding-right:20px!important}.fluid-image{height:auto!important;max-width:100%!important;width:100%!important}.mobile-stack{display:block!important;width:100%!important}.mobile-stack-pad{padding-left:0!important;padding-top:16px!important}}</style></head><body width="100%" style="margin:0;padding:0!important;background-color:#F3F4F6"><center role="article" aria-roledescription="email" lang="en" style="width:100%;background-color:#F3F4F6"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;background-color:#F3F4F6"><tbody><tr><td align="center" style="padding:0"><div class="email-container" style="max-width:600px;margin:0 auto"><div style="display:none;font-size:1px;color:#F3F4F6;line-height:1px;font-family:Arial,sans-serif;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all" aria-hidden="true">Three quick steps to get value from your new workspace.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" align="center" class="email-container" style="background-color:#FFFFFF"><tbody><tr><td align="center" style="background-color:#FFFFFF;padding:10px 32px 0px 32px"><p style="color:#6B7280;font-family:Arial;font-size:11px;line-height:17px;margin:0px;text-align:center">Three quick steps to get value from your new workspace.</p></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:28px 32px 16px 32px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/logo-sample.svg" width="120" height="40" alt="Company logo" border="0" class="fluid-image" style="display:block;max-width:120px;width:100%"></td></tr><tr><td align="center" style="padding:6px 32px 8px 32px"><h1 style="color:#0369A1;font-family:Arial;font-size:34px;font-weight:700;line-height:41px;margin:0px;text-align:center">Welcome aboard!</h1></td></tr><tr><td align="center" style="padding:0px 64px 20px 64px"><p style="color:#111827;font-family:Arial;font-size:14px;line-height:22px;margin:0px;text-align:center">We're excited to have you here. Follow these 3 simple steps to get started.</p></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DCE3EA;border-radius:7px;border-style:solid;border-width:1px;padding:20px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td align="center" valign="top" style="padding:0px;width:38px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="38"><tbody><tr><td align="center" valign="middle" style="background-color:#EFF6FF;border-radius:999px;height:38px;padding:0px;width:38px"><p style="color:#0369A1;font-family:Arial;font-size:18px;font-weight:700;line-height:38px;margin:0px;text-align:center">1</p></td></tr></tbody></table></td><td valign="top" style="padding:0px 0px 0px 18px"><h2 style="color:#111827;font-family:Arial;font-size:17px;font-weight:700;line-height:23px;margin:0px 0px 5px 0px">Complete your profile</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:20px;margin:0px">Add a few details about yourself so we can personalize your experience.</p></td></tr></tbody></table></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DCE3EA;border-radius:7px;border-style:solid;border-width:1px;padding:20px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td align="center" valign="top" style="padding:0px;width:38px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="38"><tbody><tr><td align="center" valign="middle" style="background-color:#EFF6FF;border-radius:999px;height:38px;padding:0px;width:38px"><p style="color:#0369A1;font-family:Arial;font-size:18px;font-weight:700;line-height:38px;margin:0px;text-align:center">2</p></td></tr></tbody></table></td><td valign="top" style="padding:0px 0px 0px 18px"><h2 style="color:#111827;font-family:Arial;font-size:17px;font-weight:700;line-height:23px;margin:0px 0px 5px 0px">Set up your workspace</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:20px;margin:0px">Create your workspace and invite your team to collaborate.</p></td></tr></tbody></table></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DCE3EA;border-radius:7px;border-style:solid;border-width:1px;padding:20px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td align="center" valign="top" style="padding:0px;width:38px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="38"><tbody><tr><td align="center" valign="middle" style="background-color:#EFF6FF;border-radius:999px;height:38px;padding:0px;width:38px"><p style="color:#0369A1;font-family:Arial;font-size:18px;font-weight:700;line-height:38px;margin:0px;text-align:center">3</p></td></tr></tbody></table></td><td valign="top" style="padding:0px 0px 0px 18px"><h2 style="color:#111827;font-family:Arial;font-size:17px;font-weight:700;line-height:23px;margin:0px 0px 5px 0px">Take your first action</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:20px;margin:0px">Explore key features and take your first step to success.</p></td></tr></tbody></table></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:8px 40px 32px 40px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center"><tbody><tr><td align="center" bgcolor="#0369A1" style="border-radius:6px;background-color:#0369A1"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="https://example.com/onboarding" style="height:48px;v-text-anchor:middle;width:224px" arcsize="10%" stroke="f" fillcolor="#0369A1"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial;font-size:16px;font-weight:bold"><![endif]--><a href="https://example.com/onboarding" target="_blank" style="background-color:#0369A1;border-radius:6px;color:#FFFFFF;display:inline-block;font-family:Arial;font-size:16px;font-weight:bold;line-height:48px;padding:0 24px;text-align:center;text-decoration:none;mso-hide:all">Get started</a><!--[if mso]></center></v:roundrect><![endif]--></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:0px 40px 22px 40px"><p style="color:#6B7280;font-family:Arial;font-size:12px;line-height:18px;margin:0px 0px 4px 0px;text-align:center">Need help? We're here for you.</p><a href="https://example.com/support" target="_blank" style="color:#0369A1;font-family:Arial;font-size:12px;font-weight:600;text-decoration:underline">Visit our Help Center -&gt;</a></td></tr><tr><td align="center" style="border-color:#E5E7EB;border-style:solid;border-width:1px;padding:20px 40px 12px 40px"><p style="color:#6B7280;font-family:Arial;font-size:11px;line-height:17px;margin:0px;text-align:center">The simplest way to get things done.</p></td></tr><tr><td align="center" style="padding:0px 48px 0px 48px"><p style="color:#6B7280;font-family:Arial;font-size:9px;line-height:14px;margin:0px;text-align:center">This email was sent to you. You are receiving this email because you created an account.</p></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/unsubscribe" target="_blank" style="color:#6B7280;font-family:Arial;font-size:9px;font-weight:600;text-decoration:underline">Unsubscribe</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/privacy" target="_blank" style="color:#6B7280;font-family:Arial;font-size:9px;font-weight:600;text-decoration:underline">Privacy Policy</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/terms" target="_blank" style="color:#6B7280;font-family:Arial;font-size:9px;font-weight:600;text-decoration:underline">Terms of Service</a></td></tr></tbody></table></td></tr><tr><td style="padding:0px 0px 18px 0px"><p style="margin:0px"></p></td></tr></tbody></table></div></td></tr></tbody></table></center></body></html>"`;

exports[`'welcome-simple' renderer > renders the default full email document and matches its snapshot 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no"><title>Welcome!</title><!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]--><style>html,body{margin:0!important;padding:0!important;width:100%!important;height:100%!important}*{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}table,td{mso-table-lspace:0pt!important;mso-table-rspace:0pt!important;border-collapse:collapse!important}img{-ms-interpolation-mode:bicubic;border:0;height:auto;line-height:100%;outline:none;text-decoration:none}a{text-decoration:none}@media screen and (max-width:620px){.email-container{width:100%!important;max-width:100%!important}.mobile-padding{padding-left:20px!important;padding-right:20px!important}.fluid-image{height:auto!important;max-width:100%!important;width:100%!important}.mobile-stack{display:block!important;width:100%!important}.mobile-stack-pad{padding-left:0!important;padding-top:16px!important}}</style></head><body width="100%" style="margin:0;padding:0!important;background-color:#F3F4F6"><center role="article" aria-roledescription="email" lang="en" style="width:100%;background-color:#F3F4F6"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;background-color:#F3F4F6"><tbody><tr><td align="center" style="padding:0"><div class="email-container" style="max-width:600px;margin:0 auto"><div style="display:none;font-size:1px;color:#F3F4F6;line-height:1px;font-family:Arial,sans-serif;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all" aria-hidden="true">Welcome - your account is ready.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" align="center" class="email-container" style="background-color:#FFFFFF"><tbody><tr><td align="center" style="background-color:#FFFFFF;padding:10px 32px 0px 32px"><p style="color:#6B7280;font-family:Arial;font-size:11px;line-height:17px;margin:0px;text-align:center">Welcome - your account is ready.</p></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:28px 32px 16px 32px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/logo-sample.svg" width="120" height="40" alt="Company logo" border="0" class="fluid-image" style="display:block;max-width:120px;width:100%"></td></tr><tr><td align="center" style="padding:8px 40px 4px 40px"><h1 style="color:#111827;font-family:Arial;font-size:42px;font-weight:700;line-height:48px;margin:0px;text-align:center">Welcome!</h1></td></tr><tr><td align="center" style="padding:0px 40px 18px 40px"><p style="color:#6B7280;font-family:Arial;font-size:20px;line-height:28px;margin:0px;text-align:center">We're glad you're here.</p></td></tr><tr><td align="center" style="background-color:#F5F3F7;border-radius:8px;padding:26px 52px"><p style="color:#111827;font-family:Arial;font-size:16px;line-height:25px;margin:0px;text-align:center">You're all set to get started. Take a moment to explore and see what you can do.</p></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:8px 40px 32px 40px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center"><tbody><tr><td align="center" bgcolor="#7C3AED" style="border-radius:6px;background-color:#7C3AED"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="https://example.com/app" style="height:48px;v-text-anchor:middle;width:432px" arcsize="10%" stroke="f" fillcolor="#7C3AED"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial;font-size:16px;font-weight:bold"><![endif]--><a href="https://example.com/app" target="_blank" style="background-color:#7C3AED;border-radius:6px;color:#FFFFFF;display:inline-block;font-family:Arial;font-size:16px;font-weight:bold;line-height:48px;padding:0 24px;text-align:center;text-decoration:none;mso-hide:all">Complete your profile -&gt;</a><!--[if mso]></center></v:roundrect><![endif]--></td></tr></tbody></table></td></tr><tr><td align="center" style="border-color:#E5E7EB;border-style:solid;border-width:1px;padding:0px 40px 22px 40px"><p style="color:#6B7280;font-family:Arial;font-size:12px;line-height:18px;margin:0px 0px 4px 0px;text-align:center">Need help?</p></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/help" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Visit our Help Center.</a></td><td align="center" style="padding:0px 7px"><a href="mailto:hello@example.com" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Email</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/x" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">X</a></td></tr><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/chat" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Chat</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/unsubscribe" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Unsubscribe</a></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:12px 48px 0px 48px"><p style="color:#6B7280;font-family:Arial;font-size:10px;line-height:15px;margin:0px;text-align:center">You're receiving this email because you recently created an account with us.</p></td></tr><tr><td style="padding:0px 0px 18px 0px"><p style="margin:0px"></p></td></tr></tbody></table></div></td></tr></tbody></table></center></body></html>"`;
