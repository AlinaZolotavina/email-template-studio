exports[`'newsletter-digest' renderer > renders the default full email document and matches its snapshot 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no"><title>Weekly digest</title><!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]--><style>html,body{margin:0!important;padding:0!important;width:100%!important;height:100%!important}*{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}table,td{mso-table-lspace:0pt!important;mso-table-rspace:0pt!important;border-collapse:collapse!important}img{-ms-interpolation-mode:bicubic;border:0;height:auto;line-height:100%;outline:none;text-decoration:none}a{text-decoration:none}@media screen and (max-width:620px){.email-container{width:100%!important;max-width:100%!important}.mobile-padding{padding-left:20px!important;padding-right:20px!important}.fluid-image{height:auto!important;max-width:100%!important;width:100%!important}.mobile-stack{display:block!important;width:100%!important}.mobile-stack-pad{padding-left:0!important;padding-top:16px!important}}</style></head><body width="100%" style="margin:0;padding:0!important;background-color:#F3F4F6"><center role="article" aria-roledescription="email" lang="en" style="width:100%;background-color:#F3F4F6"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;background-color:#F3F4F6"><tbody><tr><td align="center" style="padding:0"><div class="email-container" style="max-width:600px;margin:0 auto"><div style="display:none;font-size:1px;color:#F3F4F6;line-height:1px;font-family:Arial,sans-serif;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all" aria-hidden="true">This week: product thinking, design systems, and growth.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" align="center" class="email-container" style="background-color:#FFFFFF"><tbody><tr><td align="center" style="background-color:#FFFFFF;padding:10px 32px 0px 32px"><p style="color:#6B7280;font-family:Arial;font-size:11px;line-height:17px;margin:0px;text-align:center">This week: product thinking, design systems, and growth.</p></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:28px 32px 16px 32px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/logo-sample.svg" width="120" height="40" alt="Weekly Digest logo" border="0" class="fluid-image" style="display:block;max-width:120px;width:100%"></td></tr><tr><td align="center" style="padding:12px 32px 8px 32px"><h1 style="color:#111827;font-family:Arial;font-size:34px;font-weight:700;line-height:41px;margin:0px;text-align:center">Weekly digest</h1></td></tr><tr><td align="center" style="padding:0px 54px 18px 54px"><p style="color:#6B7280;font-family:Arial;font-size:15px;line-height:23px;margin:0px;text-align:center">Your weekly dose of insights, ideas, and inspiration.</p></td></tr><tr><td align="center" style="background-color:#FFFFFF;padding:8px 40px 32px 40px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center"><tbody><tr><td align="center" bgcolor="#0F766E" style="border-radius:6px;background-color:#0F766E"><!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="https://example.com/stories" style="height:48px;v-text-anchor:middle;width:496px" arcsize="10%" stroke="f" fillcolor="#0F766E"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial;font-size:16px;font-weight:bold"><![endif]--><a href="https://example.com/stories" target="_blank" style="background-color:#0F766E;border-radius:6px;color:#FFFFFF;display:inline-block;font-family:Arial;font-size:16px;font-weight:bold;line-height:48px;padding:0 24px;text-align:center;text-decoration:none;mso-hide:all">Read this week's top stories</a><!--[if mso]></center></v:roundrect><![endif]--></td></tr></tbody></table></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DDE5E5;border-style:solid;border-width:1px;padding:20px 32px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td valign="middle" class="mobile-stack" style="width:180px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/digest-strategy.png" width="180" height="135" alt="Abstract mountains and sun" border="0" class="fluid-image" style="display:block;max-width:180px;width:100%"></td><td valign="middle" class="mobile-stack mobile-stack-pad" style="padding:0px 0px 0px 22px"><p style="color:#0F766E;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px 0px 4px 0px">STRATEGY</p><h2 style="color:#111827;font-family:Arial;font-size:19px;font-weight:700;line-height:23px;margin:0px 0px 6px 0px">Five ways to build better habits</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:19px;margin:0px 0px 7px 0px">Small changes, when done consistently, can lead to big results.</p><a href="https://example.com/article-1" target="_blank" style="color:#0F766E;font-family:Arial;font-size:13px;font-weight:600;text-decoration:underline">Read more -&gt;</a></td></tr></tbody></table></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DDE5E5;border-style:solid;border-width:1px;padding:20px 32px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td valign="middle" class="mobile-stack" style="width:180px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/digest-data.png" width="180" height="135" alt="Ascending data chart" border="0" class="fluid-image" style="display:block;max-width:180px;width:100%"></td><td valign="middle" class="mobile-stack mobile-stack-pad" style="padding:0px 0px 0px 22px"><p style="color:#0F766E;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px 0px 4px 0px">DATA</p><h2 style="color:#111827;font-family:Arial;font-size:19px;font-weight:700;line-height:23px;margin:0px 0px 6px 0px">What the numbers are telling us</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:19px;margin:0px 0px 7px 0px">Key takeaways from the latest industry trends.</p><a href="https://example.com/article-2" target="_blank" style="color:#0F766E;font-family:Arial;font-size:13px;font-weight:600;text-decoration:underline">Read more -&gt;</a></td></tr></tbody></table></td></tr><tr><td style="background-color:#FFFFFF;border-color:#DDE5E5;border-style:solid;border-width:1px;padding:20px 32px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td valign="middle" class="mobile-stack" style="width:180px"><img src="https://raw.githubusercontent.com/AlinaZolotavina/email-template-studio/main/public/template-assets/digest-culture.png" width="180" height="135" alt="Conversation and feedback" border="0" class="fluid-image" style="display:block;max-width:180px;width:100%"></td><td valign="middle" class="mobile-stack mobile-stack-pad" style="padding:0px 0px 0px 22px"><p style="color:#0F766E;font-family:Arial;font-size:10px;font-weight:700;line-height:15px;margin:0px 0px 4px 0px">CULTURE</p><h2 style="color:#111827;font-family:Arial;font-size:19px;font-weight:700;line-height:23px;margin:0px 0px 6px 0px">Creating a culture of feedback</h2><p style="color:#6B7280;font-family:Arial;font-size:13px;line-height:19px;margin:0px 0px 7px 0px">Why feedback matters - and how to make it part of your everyday.</p><a href="https://example.com/article-3" target="_blank" style="color:#0F766E;font-family:Arial;font-size:13px;font-weight:600;text-decoration:underline">Read more -&gt;</a></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:18px 32px 10px 32px"><p style="color:#6B7280;font-family:Arial;font-size:12px;line-height:18px;margin:0px 0px 3px 0px;text-align:center">Enjoying the digest?</p><a href="https://example.com/share" target="_blank" style="color:#0F766E;font-family:Arial;font-size:12px;font-weight:600;text-decoration:underline">Share it with a friend.</a></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/x" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">X</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/linkedin" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">in</a></td><td align="center" style="padding:0px 7px"><a href="mailto:hello@example.com" target="_blank" style="color:#6B7280;font-family:Arial;font-size:11px;font-weight:600;text-decoration:underline">Email</a></td></tr></tbody></table></td></tr><tr><td align="center" style="padding:12px 32px 0px 32px"><p style="color:#6B7280;font-family:Arial;font-size:10px;line-height:16px;margin:0px;text-align:center">You're receiving this email because you signed up for our updates.</p></td></tr><tr><td align="center" style="padding:8px 24px 0px 24px"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" align="center"><tbody><tr><td align="center" style="padding:0px 7px"><a href="https://example.com/preferences" target="_blank" style="color:#6B7280;font-family:Arial;font-size:10px;font-weight:600;text-decoration:underline">Update preferences</a></td><td align="center" style="padding:0px 7px"><a href="https://example.com/unsubscribe" target="_blank" style="color:#6B7280;font-family:Arial;font-size:10px;font-weight:600;text-decoration:underline">Unsubscribe</a></td></tr></tbody></table></td></tr><tr><td style="padding:0px 0px 14px 0px"><p style="margin:0px"></p></td></tr></tbody></table></div></td></tr></tbody></table></center></body></html>"`;

exports[`'newsletter-promo' renderer > renders the default full email document and matches its snapshot 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no"><title>20% OFF SITEWIDE</title><!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]--><style>html,body{margin:0!important;padding:0!important;width:100%!important;height:100%!important}*{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}table,td{mso-table-lspace:0pt!important;mso-table-rspace:0pt!important;border-collapse:collapse!important}img{-ms-interpolation-mode:bicubic;border:0;height:auto;line-height:100%;outline:none;text-decoration:none}a{text-decoration:none}@media screen and (max-width:620px){.email-container{width:100%!important;max-width:100%!important}.mobile-padding{padding-left:20px!important;padding-right:20px!important}.fluid-image{height:auto!important;max-width:100%!important;width:100%!important}.mobile-stack{display:block!important;width:100%!important}.mobile-stack-pad{padding-left:0!important;padding-top:16px!important}}</style></head><body width="100%" style="margin:0;padding:0!important;background-color:#FFF7ED"><center role="article" aria-roledescription="email" lang="en" style="width:100%;background-color:#FFF7ED"><table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;background-color:#FFF7ED"><tbody><tr><td align="center" style="padding:0"><div class="email-container" style="max-width:600px;margin:0 auto"><div style="display:none;font-size:1px;color:#FFF7E